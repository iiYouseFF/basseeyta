# Server
PORT=3000
NODE_ENV=development

# Supabase (server-side, service role)
SUPABASE_URL=https://eczybgjywdppvyyygnrd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Direct DB connection (for migrations & pg_cron)
DATABASE_URL=postgres://postgres:password@db.eczybgjywdppvyyygnrd.supabase.co:5432/postgres

# Firebase Admin (Auth + FCM)
FIREBASE_PROJECT_ID=bassyta-851a5
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@bassyta-851a5.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# JWT (custom, issued after Firebase OTP verify)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=30d

# Storage (CDN base for public bucket URLs)
STORAGE_CDN_BASE=https://eczybgjywdppvyyygnrd.supabase.co/storage/v1/object/public

# Payments
STRIPE_SECRET_KEY=sk_test_...
FAWRY_MERCHANT_CODE=...
FAWRY_SECURITY_KEY=...

# AI
OPENAI_API_KEY=sk-...

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Cron jobs security
CRON_SECRET=your_cron_secret

# OTP mock bypass (dev only)
USE_MOCK_OTP=true
